# =============================================================================
# Presently — Environment Variables
# =============================================================================
#
# Copia este archivo a .env.local y llena los valores.
# NUNCA commiteés .env.local al repo.
#
# Los valores marcados como REQUIRED son bloqueantes — sin ellos la app no
# arranca. Los OPTIONAL tienen fallbacks o son para features avanzadas.

# -----------------------------------------------------------------------------
# CONVEX — REQUIRED
# -----------------------------------------------------------------------------
# Se genera automáticamente cuando corrés `npx convex dev` por primera vez.
NEXT_PUBLIC_CONVEX_URL=

# -----------------------------------------------------------------------------
# CLERK — REQUIRED
# -----------------------------------------------------------------------------
# Desde el dashboard de Clerk → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# URLs de auth (déjalas en estos defaults, es lo que espera el middleware)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/new
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/new

# -----------------------------------------------------------------------------
# LLM (Anthropic o OpenAI) — REQUIRED (al menos uno)
# -----------------------------------------------------------------------------
# Cuál usar por defecto: "anthropic" | "openai"
LLM_PROVIDER=anthropic

# Anthropic (recomendado para Red Team y jurado)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI (fallback o alternativa)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# -----------------------------------------------------------------------------
# VAPI — REQUIRED
# -----------------------------------------------------------------------------
# Desde el dashboard de Vapi
VAPI_API_KEY=
NEXT_PUBLIC_VAPI_PUBLIC_KEY= # para el SDK del frontend

# IDs de los asistentes creados en el dashboard de Vapi.
# Cada asistente = un jurado, con su voz y su prompt.
VAPI_ASSISTANT_ID_HACKATHON=
VAPI_ASSISTANT_ID_THESIS=
VAPI_ASSISTANT_ID_INVESTOR=

# URL pública del endpoint que Vapi va a usar como custom LLM.
# En dev: usa ngrok o similar. En prod: la URL de Vercel.
VAPI_CUSTOM_LLM_URL=https://tu-app.vercel.app/api/llm

# -----------------------------------------------------------------------------
# ELEVENLABS — REQUIRED (para voces custom)
# -----------------------------------------------------------------------------
ELEVENLABS_API_KEY=

# Voice IDs — elige 3 voces del catálogo de ElevenLabs.
# Sugerencias en docs/05-tools-and-credits.md
ELEVENLABS_VOICE_ID_HACKATHON=
ELEVENLABS_VOICE_ID_THESIS=
ELEVENLABS_VOICE_ID_INVESTOR=

# -----------------------------------------------------------------------------
# TAVILY — REQUIRED (para Chaos Event)
# -----------------------------------------------------------------------------
TAVILY_API_KEY=tvly-...

# -----------------------------------------------------------------------------
# NEXT.JS — REQUIRED
# -----------------------------------------------------------------------------
# En prod, la URL pública del deploy. En dev, http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# OPTIONAL — features avanzadas
# -----------------------------------------------------------------------------
# Si quieren activar el modo debug con logs verbose
DEBUG_MODE=false

# Si quieren forzar el modo demo pre-grabada (para backup en caso de emergencia)
FORCE_DEMO_MODE=false

# Modelo pequeño para tareas de clasificación (follow-up decision)
# Si no se especifica, usa el modelo principal
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
OPENAI_MODEL_FAST=gpt-4o-mini
